NUXT_PUBLIC_API_BASE=http://localhost:8000
NUXT_PUBLIC_DEMO_BOOKING_URL=https://cal.com/mc-studio/demo-personal-app

# The DSN is public by design. Sentry stays disabled while it is empty.
NUXT_PUBLIC_SENTRY_DSN=
NUXT_PUBLIC_SENTRY_ENVIRONMENT=local
NUXT_PUBLIC_SENTRY_RELEASE=
NUXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1

# Build-only source map upload. SENTRY_AUTH_TOKEN is secret and must never use
# the NUXT_PUBLIC prefix or be copied into a runtime image.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
