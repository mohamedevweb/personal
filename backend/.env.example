APP_NAME=Personal
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=personal
DB_USERNAME=personal
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Transactional email goes through Resend. Set RESEND_API_KEY to a key from
# https://resend.com/api-keys and verify the sending domain there. Use
# MAIL_MAILER=log locally to write mail to storage/logs/laravel.log instead.
MAIL_MAILER=resend
RESEND_API_KEY=
MAIL_FROM_ADDRESS="no-reply@usepersonal.app"
# Literal value: Docker's env_file does not interpolate "${APP_NAME}".
MAIL_FROM_NAME="Personal"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Mints an unauthenticated demo token. Local only, and never in a shared environment.
ENABLE_DEV_SESSION=true

# Content generation: "openai" (default), "claude", or "mock" for deterministic
# offline copy. A driver with no API key configured falls back to "mock".
CONTENT_GENERATION_DRIVER=openai

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
# Reasoning models only ("minimal".."high"); leave empty for other models.
OPENAI_REASONING_EFFORT=
OPENAI_MAX_OUTPUT_TOKENS=8000
OPENAI_TIMEOUT=120

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=medium
ANTHROPIC_MAX_TOKENS=8000
ANTHROPIC_TIMEOUT=120

# Niche content discovery: "mock" (default, no cost) or "apify" for real scraping.
# Apify bills per result — APIFY_RESULTS_LIMIT is the per-hashtag cost cap.
DISCOVERY_DRIVER=mock
APIFY_TOKEN=
APIFY_INSTAGRAM_ACTOR=apify~instagram-scraper
APIFY_RESULTS_LIMIT=30
# Re-scrape post URLs to recover likes/views (hashtag pages hide them). Doubles
# the result count; set false for cheaper, engagement-blind runs.
APIFY_ENRICH_METRICS=true
APIFY_TIMEOUT=120
DISCOVERY_HASHTAG_LIMIT=10
DISCOVERY_CACHE_DAYS=7
# A hashtag scraped within this many days is skipped (shared across all users).
DISCOVERY_COOLDOWN_DAYS=7
# Account measurement: scraping a whole profile is what yields the real follower
# count and the median engagement every post of that account is scored against.
APIFY_PROFILE_ACTOR=apify~instagram-profile-scraper
DISCOVERY_PROFILE_POSTS=12
DISCOVERY_MEASURE_COOLDOWN_DAYS=3
DISCOVERY_MEASURE_BATCH=30
# Accounts per Apify call: a synchronous run is capped at five minutes and a whole
# batch does not reliably fit inside it.
DISCOVERY_MEASURE_CHUNK=10
# The feed only ranks posts published inside this window.
DISCOVERY_FEED_WINDOW_DAYS=30
# Minimum lift over the creator's own average for a post to reach the feed.
DISCOVERY_MIN_OUTLIER_SCORE=1.2
# Absolute floors. The lift is a ratio, so without these an account whose median
# post gets 2 likes turns a 3-like post into a 1.5x "outlier".
DISCOVERY_MIN_FOLLOWERS=5000
DISCOVERY_MIN_POST_ENGAGEMENT=500

# Instagram API with Instagram Login (professional accounts only)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:8000/instagram/callback
INSTAGRAM_API_VERSION=v25.0
INSTAGRAM_SCOPES=instagram_business_basic,instagram_business_content_publish,instagram_business_manage_insights
INSTAGRAM_MEDIA_LIMIT=25
