APP_NAME=Personal
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
# Comma-separated emails allowed to open the internal queue dashboard.
QUEUE_DASHBOARD_EMAILS=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Error monitoring stays disabled until a project DSN is configured. Keep
# default PII collection off unless the privacy policy is updated accordingly.
SENTRY_LARAVEL_DSN=
SENTRY_SAMPLE_RATE=1.0
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_SEND_DEFAULT_PII=false
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=git-commit-sha

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=personal
DB_USERNAME=personal
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=210

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Transactional email goes through Resend. Set RESEND_API_KEY to a key from
# https://resend.com/api-keys and verify the sending domain there. Use
# MAIL_MAILER=log locally to write mail to storage/logs/laravel.log instead.
MAIL_MAILER=resend
RESEND_API_KEY=
MAIL_FROM_ADDRESS="no-reply@usepersonal.app"
# Literal value: Docker's env_file does not interpolate "${APP_NAME}".
MAIL_FROM_NAME="Personal"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Mints an unauthenticated demo token. Local only, and never in a shared environment.
ENABLE_DEV_SESSION=true

# Content generation: "openai" (default), "claude", or "mock" for deterministic
# offline copy. A driver with no API key configured falls back to "mock".
CONTENT_GENERATION_DRIVER=openai
CONTENT_GENERATION_STALE_AFTER_SECONDS=180

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
# Structured profile and auxiliary analysis.
OPENAI_ANALYSIS_REASONING_EFFORT=low
OPENAI_ANALYSIS_MAX_OUTPUT_TOKENS=5000
# Remix generation has its own low-latency model and output budget.
OPENAI_REMIX_MODEL=gpt-5.6-luna
OPENAI_REMIX_REASONING_EFFORT=none
OPENAI_REMIX_MAX_OUTPUT_TOKENS=2500
OPENAI_TIMEOUT=120
# Reading the spoken script of a reel.
OPENAI_TRANSCRIPTION_MODEL=whisper-1

# Refetching one post to recover its carousel slides or a playable video url.
# Costs one provider credit, only for posts a member actually opens.
POST_MEDIA_REFRESH_ENABLED=true
POST_MEDIA_REFRESH_TTL_HOURS=6
POST_MEDIA_REFRESH_COOLDOWN_HOURS=24

# Reel transcription. Off means the Creator DNA and the remix source stay on
# captions only.
REEL_TRANSCRIPTION_ENABLED=true
REEL_TRANSCRIPTION_MAX_BYTES=26214400
REEL_TRANSCRIPTION_MAX_DURATION=180
REEL_TRANSCRIPTION_DOWNLOAD_TIMEOUT=60
CREATOR_DNA_TRANSCRIBED_REELS=4

# OCR and visual structure for a carousel, both the creator's own and the
# source of a remix.
CAROUSEL_ANALYSIS_ENABLED=true
OPENAI_VISION_MODEL=gpt-5
CREATOR_DNA_ANALYZED_CAROUSELS=2
CAROUSEL_ANALYSIS_MAX_SLIDES=6
CAROUSEL_ANALYSIS_IMAGE_DETAIL=low
CAROUSEL_ANALYSIS_MAX_OUTPUT_TOKENS=4000

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=medium
ANTHROPIC_MAX_TOKENS=8000
ANTHROPIC_TIMEOUT=120

# Public Instagram discovery uses ScrapeCreators. Mock data is limited to
# non-production environments and automated tests.
DISCOVERY_DRIVER=scrapecreators
SCRAPECREATORS_API_KEY=
SCRAPECREATORS_BASE_URL=https://api.scrapecreators.com
SCRAPECREATORS_TIMEOUT=30
SCRAPECREATORS_RETRIES=3
SCRAPECREATORS_RETRY_DELAY_MS=500
# ScrapeCreators profile cache: 1d, 3d, 7d, 14d, or 30d.
SCRAPECREATORS_CACHE_MAX_AGE=3d

# Adaptive account scheduling. All provider data remains shared globally, and
# every metric refresh is grouped by creator to avoid one call per post.
INSTAGRAM_SCRAPING_SCHEDULED=false
INSTAGRAM_SCRAPE_CREATOR_BATCH=30
INSTAGRAM_SCRAPE_METRICS_CREATOR_BATCH=30
INSTAGRAM_SCRAPE_METRICS_POSTS_PER_CREATOR=24
INSTAGRAM_SCRAPE_HOT_MIN_HOURS=6
INSTAGRAM_SCRAPE_HOT_MAX_HOURS=12
INSTAGRAM_SCRAPE_ACTIVE_MIN_HOURS=24
INSTAGRAM_SCRAPE_ACTIVE_MAX_HOURS=24
INSTAGRAM_SCRAPE_WARM_MIN_HOURS=48
INSTAGRAM_SCRAPE_WARM_MAX_HOURS=72
INSTAGRAM_SCRAPE_COLD_MIN_HOURS=120
INSTAGRAM_SCRAPE_COLD_MAX_HOURS=168
INSTAGRAM_SCRAPE_HOT_PRIORITY=70
INSTAGRAM_SCRAPE_ACTIVE_PRIORITY=40
INSTAGRAM_SCRAPE_WARM_PRIORITY=15
INSTAGRAM_SCRAPE_USER_SELECTION_WEIGHT=10
INSTAGRAM_SCRAPE_RELEVANT_FEED_WEIGHT=2
INSTAGRAM_SCRAPE_APPROVED_WEIGHT=20
INSTAGRAM_SCRAPE_POSTING_FREQUENCY_WEIGHT=20
INSTAGRAM_SCRAPE_RECENT_POST_WEIGHT=20
INSTAGRAM_SCRAPE_RECENT_OUTLIER_WEIGHT=10
INSTAGRAM_SCRAPE_HOT_POST_WEIGHT=10
INSTAGRAM_SCRAPE_FAILURE_BACKOFF_HOURS=6
INSTAGRAM_SCRAPE_FAILURE_BACKOFF_MAX_HOURS=72
INSTAGRAM_METRICS_FIRST_DAY_HOURS=6
INSTAGRAM_METRICS_DAYS_ONE_TO_THREE_HOURS=24
INSTAGRAM_METRICS_DAYS_FOUR_TO_SEVEN_HOURS=48
INSTAGRAM_METRICS_HOT_MIN_HOURS=3
INSTAGRAM_METRICS_HOT_MAX_HOURS=6
INSTAGRAM_METRICS_WARM_HOURS=24
INSTAGRAM_METRICS_COLD_HOURS=72
INSTAGRAM_METRICS_EXCEPTIONAL_HOURS=168
INSTAGRAM_METRICS_FAILURE_BACKOFF_HOURS=12
INSTAGRAM_METRICS_HOT_OUTLIER_SCORE=2.0
INSTAGRAM_METRICS_EXCEPTIONAL_OUTLIER_SCORE=3.0
INSTAGRAM_METRICS_HOT_VELOCITY_MULTIPLIER=2.0
INSTAGRAM_METRICS_WARM_VELOCITY_MULTIPLIER=0.5
INSTAGRAM_METRICS_BASELINE_MATURITY_HOURS=72
INSTAGRAM_METRICS_MEANINGFUL_GROWTH_RATE=0.05
INSTAGRAM_METRICS_SNAPSHOT_RAW_DAYS=30
INSTAGRAM_METRICS_SNAPSHOT_RETENTION_DAYS=365
DISCOVERY_HASHTAG_LIMIT=10
DISCOVERY_CACHE_DAYS=7
# A hashtag scraped within this many days is skipped (shared across all users).
DISCOVERY_COOLDOWN_DAYS=7
# Discovery recovery cutoff. Ongoing creator refreshes use the adaptive values
# above; profile measurement still yields the median used for outlier scoring.
DISCOVERY_PROFILE_POSTS=12
DISCOVERY_REFRESH_PROFILE_POSTS=30
DISCOVERY_SEARCH_QUERY_LIMIT=6
DISCOVERY_SEARCH_RESULTS_PER_QUERY=8
DISCOVERY_SEED_LIMIT=8
DISCOVERY_RELATED_PER_SEED=6
DISCOVERY_MEASURE_COOLDOWN_DAYS=3
DISCOVERY_MEASURE_BATCH=30
INSTAGRAM_MEDIA_CACHE_DISK=local
INSTAGRAM_MEDIA_CACHE_DAYS=7
INSTAGRAM_MEDIA_BROWSER_CACHE_HOURS=24
INSTAGRAM_MEDIA_SIGNATURE_HOURS=24
INSTAGRAM_MEDIA_TIMEOUT=15
INSTAGRAM_MEDIA_MAX_BYTES=10485760
INSTAGRAM_VIDEO_MAX_BYTES=104857600
# Accounts per measurement job, keeping each queue payload bounded.
DISCOVERY_MEASURE_CHUNK=10
# The feed only ranks posts published inside this window.
DISCOVERY_FEED_WINDOW_DAYS=30
DISCOVERY_FEED_SIZE=24
# Best-effort minimum number of cards in the first feed batch. Fallback cards
# are still measured, safe, approved and above the absolute engagement floor.
DISCOVERY_MINIMUM_FEED_SIZE=6
DISCOVERY_FALLBACK_MIN_OUTLIER_SCORE=1.0
# Replenish active primary verticals when their eligible catalogue is too small.
DISCOVERY_VERTICAL_SUPPLY_ENABLED=true
DISCOVERY_VERTICAL_MINIMUM_POSTS=8
DISCOVERY_VERTICAL_MINIMUM_CREATORS=4
DISCOVERY_VERTICAL_SUPPLY_COOLDOWN_DAYS=3
DISCOVERY_VERTICAL_SUPPLY_BATCH=20
DISCOVERY_CONTENT_RETENTION_DAYS=90
DISCOVERY_CURATED_CATALOG_ONLY=false
CATALOG_MIN_FOLLOWERS=5000
CATALOG_ACTIVE_WITHIN_DAYS=30
CATALOG_POSTS_WINDOW_DAYS=90
CATALOG_MIN_POSTS=6
CATALOG_MIN_METRIC_COVERAGE=0.70
CATALOG_MIN_MEDIAN_ENGAGEMENT=500
CATALOG_TARGET_POSTS_PER_VERTICAL=60
CATALOG_TARGET_REELS_PER_VERTICAL=30
CATALOG_TARGET_CAROUSELS_PER_VERTICAL=30
# Minimum lift over the creator's own average for a post to reach the feed.
DISCOVERY_MIN_OUTLIER_SCORE=1.2
# Absolute floors. The lift is a ratio, so without these an account whose median
# post gets 2 likes turns a 3-like post into a 1.5x "outlier".
DISCOVERY_MIN_FOLLOWERS=5000
DISCOVERY_MIN_POST_ENGAGEMENT=500
# Brand-safety policy for discovered public content. With an OpenAI key, text and
# thumbnails are checked by the multimodal moderation model before ingestion.
DISCOVERY_CONTENT_SAFETY_ENABLED=true
DISCOVERY_CONTENT_SAFETY_USE_OPENAI=true
DISCOVERY_CONTENT_SAFETY_FAIL_CLOSED=true
DISCOVERY_CONTENT_SAFETY_MODEL=omni-moderation-latest
# Fixed product policy: sexual/suggestive, nudity, lingerie/bikini,
# sexual/adult topics and graphic violence. Every carousel frame is checked.
DISCOVERY_CONTENT_POLICY_ENABLED=true
DISCOVERY_CONTENT_POLICY_MODEL=gpt-5
DISCOVERY_CONTENT_POLICY_REASONING_EFFORT=low
DISCOVERY_CONTENT_POLICY_MAX_OUTPUT_TOKENS=2500
DISCOVERY_CONTENT_POLICY_MAX_FRAMES=10
DISCOVERY_CONTENT_POLICY_IMAGE_DETAIL=low

# For You ranking weights. They are normalized at runtime, so they do not need
# to add up to exactly 1.0.
FEED_WEIGHT_OUTLIER=0.60
FEED_WEIGHT_REACH=0.20
FEED_WEIGHT_RECENCY=0.20
FEED_WEIGHT_PERFORMANCE=0.75
FEED_WEIGHT_CREATOR_AFFINITY=0.25
FEED_MIN_CREATOR_AFFINITY=0.50
FEED_EXPLORE_MIN_CREATOR_AFFINITY=0.20
FEED_EXPLORE_SIZE=6
FEED_OUTLIER_CEILING=3.0
FEED_REACH_CEILING=6.0

# Instagram API with Instagram Login (professional accounts only)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:8000/instagram/callback
INSTAGRAM_API_VERSION=v25.0
INSTAGRAM_SCOPES=instagram_business_basic,instagram_business_content_publish,instagram_business_manage_insights
INSTAGRAM_MEDIA_LIMIT=25
